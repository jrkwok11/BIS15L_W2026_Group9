library(tidyverse)
library(tibble)
library(janitor)
library(naniar)
library(dplyr)
library(shiny)
library(shinydashboard)
library(shinythemes)
gapminder_life_expectancy<- read.csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/Life_expectancy.csv")
co2_emissions<-read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/co2_pcap_cons.csv")
Pop<-read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/pop.csv")
Hiv_death<-read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/hiv_death.csv")
Child_death<- read.csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/number_of_child_deaths.csv")
kcals_per_day<- read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/kilocalories_per_person_and_day.csv")
gdp<- read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/gdp.csv")
lung_cancerF<- read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/lung_cancer_f.csv")
lung_cancerM<- read_csv("C:/Users/Miala/OneDrive/Desktop/BIS15L_W2026_Group9/Gapminder/Data/lung_cancer_m.csv")
gapminder_life_expectancy<- gapminder_life_expectancy %>%
pivot_longer(-c(name,geo),
names_to = "year",
values_to = "life_expectancy") %>%
mutate(year= str_remove(year, "X"))
Child_death<-Child_death %>%
pivot_longer(-c(name,geo),
names_to = "year",
values_to = "cild_death") %>%
mutate(year= str_remove(year, "X"))
co2_emissions<- co2_emissions %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "Co2_emissions")
pop<- Pop %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "population")
hiv_death<- Hiv_death %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "hiv_deaths")
kcals_per_day<- kcals_per_day %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "kcal")
gdp<- gdp %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "gdp")
lung_cancerF<-lung_cancerF %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "lung_cancerf")
lung_cancerM<-lung_cancerM %>%
pivot_longer(-c(geo,name),
names_to = "year",
values_to = "lung_cancerm")
gp<-full_join(Child_death, gapminder_life_expectancy, by= c("name", "geo","year"))
gp2<-full_join(gp, co2_emissions, by= c("name", "geo","year"))
gp3<-full_join(gp2,pop, by= c("name", "geo","year"))
gp4<-full_join(gp3,hiv_death, by= c("name", "geo", "year") )
gp5<- full_join(gp4, kcals_per_day, by = c("name","geo","year"))
gp6<- full_join(gp5, gdp, by = c("name", "year","geo") )
gp7<- full_join(gp6,lung_cancerF, by = c("name", "year","geo") )
gapminder<- full_join(gp7,lung_cancerM, by = c("name", "year","geo") )
gapminder<- gapminder %>%
filter(year>= "1915", year<="2022")
gapminder
write.csv(gapminder, file="gapminder.csv", row.names=FALSE)
